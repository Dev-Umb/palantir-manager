page{height:100%;display:flex;flex-direction:column;background:#f4f5f7;color:#182331}.scrollarea{flex:1;min-height:0}.oa{padding:28rpx}.oa .box{background:#fff;border-radius:16rpx;padding:28rpx;margin-bottom:24rpx}.oa .row,.oa-bottom{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.oa .heading{font-weight:600;font-size:29rpx;margin-bottom:18rpx}.oa .title{font-size:36rpx;margin:20rpx 0}.oa .amount{font-size:42rpx;font-weight:600;margin:22rpx 0;color:#2864bd}.oa .sub{color:#8a93a0;font-size:24rpx;margin:12rpx 0}.oa .status{color:#2864bd;font-size:24rpx}.oa .text-button{background:transparent;color:#2864bd;padding:8rpx;font-size:25rpx;line-height:1.5;margin:0}.oa button::after{border:0}.oa .primary,.oa-bottom .primary{background:#edf3fe;color:#2864bd}.oa .grow{flex:1;min-width:0;word-break:break-all}.oa .file{background:#f6f7f9;padding:16rpx;margin-top:14rpx;border-radius:10rpx}.oa .eye{background:transparent;color:#2864bd;padding:6rpx 12rpx;line-height:1.5;font-size:30rpx;margin:0}.oa .expense{padding:22rpx 0;border-bottom:1rpx solid #eef0f3}.oa .node{padding:18rpx 24rpx;border-left:3rpx solid #cfdff7;margin:20rpx 0}.oa .note{white-space:pre-wrap;margin:18rpx 0;font-size:27rpx}.oa input,.oa textarea,.oa .field{box-sizing:border-box;width:100%;padding:20rpx 0;border-bottom:1rpx solid #edf0f3;min-height:80rpx;font-size:28rpx}.oa textarea{height:170rpx}.oa .error{color:#b54b40;background:#fff1ee;padding:20rpx;margin-bottom:20rpx}.oa .cc-person{display:flex;align-items:center;padding:12rpx 0}.oa-bottom{background:#fff;padding:20rpx 28rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #edf0f3}.oa-bottom button{margin:0;font-size:28rpx}.form-space{padding-bottom:40rpx}

.oa .eye-icon{width:32rpx;height:20rpx;border:2rpx solid #2864bd;border-radius:50%;display:flex;align-items:center;justify-content:center}.oa .eye-pupil{width:8rpx;height:8rpx;background:#2864bd;border-radius:50%}
.oa .box{border-radius:24rpx;padding:36rpx;margin-bottom:28rpx}.oa .record-title{margin:20rpx 0 10rpx;font-size:29rpx;line-height:1.5}.oa .record .sub{margin:0}.oa .record-footer{border-top:1rpx solid #eef0f3;margin-top:24rpx;padding-top:24rpx}.oa .record-amount{font-size:36rpx;font-weight:600}.oa .status{border-radius:10rpx;padding:8rpx 16rpx;white-space:nowrap;font-size:22rpx;background:#edf3fb}.oa .status.pending{background:#fff4df;color:#94691c}.oa .status.approved{background:#edf7f1;color:#2b7056}.oa .status.rejected{background:#fff0ec;color:#a84b3a}.oa .scope-tab{color:#778491;border-bottom:4rpx solid transparent;border-radius:0}.oa .scope-tab.selected{color:#2864bd;border-bottom-color:#2864bd}.oa .field-label{font-size:24rpx;color:#566372;margin:24rpx 0 12rpx}.oa input,.oa textarea,.oa .field{border:1rpx solid #dbe2e9;border-radius:16rpx;padding:20rpx;background:#fff}.oa textarea{height:160rpx}.oa-bottom .total-label{font-size:22rpx;color:#6b7787}.oa-bottom .total-amount{font-size:40rpx;font-weight:600;margin-top:6rpx}.oa .node{position:relative}.oa .node:before{content:'';position:absolute;left:-8rpx;top:26rpx;width:12rpx;height:12rpx;border-radius:50%;background:#246b95;border:2rpx solid #fff}
.oa{padding-bottom:calc(36rpx + env(safe-area-inset-bottom))}.oa .oa-pagination{justify-content:center;margin:24rpx 0}.oa .oa-pagination button{margin:0;flex:1;font-size:24rpx;line-height:2.5}.oa .oa-pagination text{flex:none;white-space:nowrap;min-width:90rpx;text-align:center;font-size:24rpx}.oa .create-row{display:flex;justify-content:flex-end;margin:20rpx 0}.oa .create-row button{margin:0;font-size:25rpx;line-height:2.5;padding:0 24rpx}
.oa .file .eye,.oa .file .text-button{width:auto;flex:none;min-width:0}.oa .file .grow{flex:1;min-width:0}.oa .file{gap:12rpx}.oa .file .sub{word-break:normal}.oa .file .eye{display:flex;align-items:center;justify-content:center;min-height:64rpx;min-width:64rpx}
