@import "./common.wxss";

.create-row{display:flex;gap:20rpx}.create-row button{flex:1;margin:0}.batch-row{padding:22rpx 0;border-bottom:1rpx solid #edf0f5;font-size:28rpx}

.draft-source{display:flex;align-items:center;gap:12rpx;color:#788797;font-size:24rpx;margin-top:16rpx}.draft-unread-dot{width:12rpx;height:12rpx;border-radius:50%;background:#e5484d;flex-shrink:0}

.record-actions{display:flex;align-items:center;gap:16rpx}
.oa .approval-record{padding:30rpx 32rpx;border:1rpx solid #e4e9f0;box-shadow:0 4rpx 16rpx rgba(27,47,74,.03)}
.approval-top{display:flex;justify-content:space-between;gap:24rpx;align-items:flex-start}.approval-person{flex:1;min-width:0}.approval-label{color:#647184;font-size:23rpx;line-height:1.5;margin-bottom:10rpx}.approval-name{font-size:32rpx;font-weight:600;line-height:1.4;word-break:break-all}.approval-money{text-align:right;max-width:65%;flex-shrink:0}.approval-value{font-size:42rpx;font-weight:600;color:#1b3659;line-height:1.2;word-break:break-all;font-variant-numeric:tabular-nums}
.approval-subject{margin-top:26rpx;font-size:29rpx;font-weight:600;line-height:1.5;word-break:break-all}.approval-meta{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-top:16rpx;flex-wrap:wrap}.approval-type{font-size:25rpx;color:#40556d}.approval-reason{margin-top:18rpx;font-size:26rpx;color:#586779;line-height:40rpx;max-height:80rpx;overflow:hidden;word-break:break-all}.approval-reference{font-size:23rpx;color:#647184;margin-top:22rpx;line-height:1.5}.approval-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:22rpx;padding-top:22rpx;border-top:1rpx solid #edf0f4;font-size:25rpx;line-height:1.5}.approval-node{color:#586779;flex:1;min-width:0;word-break:break-all}.approval-open{color:#245ba4;font-weight:600;flex-shrink:0}
