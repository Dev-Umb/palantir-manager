<navigation-bar title="报销通知" back="{{true}}" color="#182331" background="#ffffff"/><scroll-view scroll-y class="scrollarea" type="list"><view class="oa"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view class="box" wx:for="{{rows}}" wx:key="id" data-id="{{item.version_id}}" bindtap="open"><view>{{item.read_at?'':'● '}}{{item.message}}</view><view class="sub">{{item.date}} · {{item.read_at?'已读':'未读'}}</view></view><view wx:if="{{!rows.length && !loading}}" class="sub">暂无通知</view><view class="row oa-pagination"><button disabled="{{page<=1}}" bindtap="previous">上一页</button><text>{{page}} / {{last}}</text><button disabled="{{page>=last}}" bindtap="next">下一页</button></view></view></scroll-view>
