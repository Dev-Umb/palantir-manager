@import "./common.wxss";
.oa.form-space{padding:24rpx 28rpx 40rpx}
.oa .box{padding:28rpx;border-radius:20rpx;margin-bottom:24rpx}
.oa .heading{font-size:30rpx;line-height:1.5;margin-bottom:8rpx}
.oa .field-label{font-size:24rpx;font-weight:400;line-height:1.5;color:#687586;margin:24rpx 0 12rpx}
.oa input,.oa textarea{font-size:28rpx;font-weight:400;color:#263445;border:1rpx solid #e1e7ee;background:#fafbfd;border-radius:14rpx;padding:20rpx 22rpx;line-height:1.65;box-sizing:border-box}
.oa input{height:88rpx;min-height:88rpx}
.oa textarea{height:176rpx;min-height:176rpx}
.oa textarea.expense-description{height:244rpx;min-height:244rpx;line-height:44rpx}
.oa .expense-fields{display:flex;flex-direction:row;gap:20rpx;align-items:flex-start}
.oa .expense-field{flex:1;min-width:0}
.oa .date-control{height:88rpx;box-sizing:border-box;display:flex;flex-direction:row;align-items:center;border:1rpx solid #e1e7ee;background:#fafbfd;border-radius:14rpx;padding-left:20rpx}
.oa .date-control picker{flex:1;min-width:0}
.oa .date-value{font-size:26rpx;line-height:86rpx;white-space:nowrap;font-weight:400}
.oa .placeholder{color:#8a95a3}
.oa button.clear-date{flex:none;width:56rpx;min-width:56rpx;height:84rpx;padding:0;line-height:84rpx;font-size:32rpx;font-weight:400;background:transparent;color:#8090a0;margin:0}
.oa .invoice-file{background:#f6f8fb;border:1rpx solid #edf0f5;border-radius:14rpx;padding:20rpx;margin-top:24rpx}
.oa .invoice-top{display:flex;flex-direction:row;align-items:center;gap:16rpx}
.oa .invoice-icon{flex:none;display:flex;align-items:center;justify-content:center;width:60rpx;height:68rpx;border-radius:10rpx;background:#e8eef8;color:#41679d;font-size:20rpx;font-weight:500}
.oa .invoice-name{font-size:26rpx;line-height:1.5;font-weight:400;word-break:break-all}
.oa .invoice-status{font-size:22rpx;line-height:1.5;color:#738297;margin-top:4rpx}
.oa .invoice-actions{display:flex;flex-direction:row;align-items:center;gap:24rpx;border-top:1rpx solid #e7edf4;margin-top:16rpx;padding-top:8rpx}
.oa .invoice-actions .text-button{width:auto;min-width:0;padding:12rpx 0;margin-right:24rpx;font-size:24rpx;font-weight:400;min-height:64rpx}
.oa .invoice-actions .remove-invoice{margin-left:auto;margin-right:0;color:#7b8797}
.oa .invoice-error{font-size:24rpx;line-height:1.6;color:#b54b40;margin-top:12rpx}
.oa button.add-invoice{margin-top:20rpx;width:100%;background:#fff;border:1rpx dashed #cbd7e6;border-radius:14rpx;color:#456b9e;font-size:25rpx;font-weight:400;padding:20rpx 12rpx}
.oa-bottom .primary{background:#2864bd;color:#fff;min-width:280rpx;border-radius:14rpx;font-size:28rpx;font-weight:500;padding:22rpx 28rpx}
.oa-bottom .total-amount{font-size:36rpx;line-height:1.3}

.invoice-review-mask{position:fixed;top:0;right:0;bottom:0;left:0;background:rgba(20,31,47,.42);z-index:1000;display:flex;flex-direction:column;justify-content:flex-end}
.invoice-review-sheet{background:#fff;border-radius:28rpx 28rpx 0 0;height:80%;max-height:85%;display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom)}
.review-header{padding:32rpx 32rpx 20rpx;flex:none;border-bottom:1rpx solid #eef1f5}
.review-title{font-size:32rpx;font-weight:600;color:#263445;line-height:1.5}
.review-file-name{font-size:24rpx;color:#7b8797;margin-top:8rpx;line-height:1.5;word-break:break-all}
.review-scroll{min-height:0;flex:1}
.review-body{padding:28rpx 32rpx}
.review-columns{display:flex;flex-direction:row;margin-bottom:32rpx}
.review-column{flex:1;min-width:0}
.review-label{font-size:24rpx;color:#738297;line-height:1.5;margin-bottom:14rpx}
.review-amount{font-size:42rpx;font-weight:600;color:#23344b;line-height:1.3}
.review-date{font-size:30rpx;color:#263445;line-height:1.8}
.review-description{white-space:pre-wrap;word-break:break-all;background:#f7f9fc;padding:24rpx;border-radius:14rpx;color:#344356;font-size:28rpx;line-height:1.75;margin-bottom:24rpx}
.review-note{font-size:23rpx;line-height:1.7;color:#7b8797;margin-top:8rpx}
.review-actions{display:flex;flex-direction:row;padding:20rpx 32rpx 28rpx;border-top:1rpx solid #eef1f5;flex:none}
.review-actions button{flex:1;font-size:28rpx;font-weight:500;padding:24rpx 12rpx;border-radius:14rpx;background:#f0f3f7;color:#596a7e;margin:0}
.review-actions button.review-confirm{margin-left:20rpx;background:#2864bd;color:#fff}
