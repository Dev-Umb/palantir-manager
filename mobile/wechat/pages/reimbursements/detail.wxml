<navigation-bar title="报销详情" back="{{true}}" color="#182331" background="#ffffff"/><scroll-view scroll-y class="scrollarea" type="list"><view class="oa"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view wx:if="{{loading || busy}}" class="sub">正在处理…</view><block wx:if="{{record}}"><view class="box"><view class="heading">申请信息</view><view class="title">{{record.title}}</view><view class="row"><text>{{record.owner.name}} · {{record.type}}</text><text class="status {{record.status}}">{{record.state}}</text></view><view class="amount">¥{{record.total}}</view><view class="sub">{{record.date}} · BX-{{record.reimbursement_id}}</view><view class="note">{{record.note}}</view><view class="row"><text class="sub">提交版本</text><button wx:for="{{record.versions}}" wx:key="number" class="text-button" data-id="{{item.id}}" bindtap="version">V{{item.number}}</button></view></view>
<view class="box"><view class="heading row" data-key="expenses" bindtap="toggle">费用明细 <text>{{expenses?'⌃':'⌄'}}</text></view><block wx:if="{{expenses}}"><button class="text-button" disabled="{{busy}}" bindtap="zip">一键下载全部发票</button><view wx:for="{{record.items}}" wx:for-item="expense" wx:for-index="i" wx:key="index" class="expense"><view class="row"><text>{{i+1}}. {{expense.description}}</text><text>¥{{expense.total}}</text></view><view class="sub">开票日期：{{expense.invoice_date || '未填写'}}</view><view wx:for="{{expense.attachments}}" wx:for-item="file" wx:for-index="j" wx:key="id" class="file row"><view class="grow">{{file.name}}<view class="sub">{{file.kind}}</view></view><button class="eye" aria-label="预览发票" data-i="{{i}}" data-j="{{j}}" data-action="preview" bindtap="file"><view class="eye-icon"><view class="eye-pupil"/></view></button><button class="text-button" data-i="{{i}}" data-j="{{j}}" data-action="download" bindtap="file">下载</button></view></view></block></view>
<view class="box"><view class="heading row" data-key="progress" bindtap="toggle">审批进度 <text>{{progress?'⌃':'⌄'}}</text></view><block wx:if="{{progress}}"><view wx:if="{{record.blocked}}" class="error">审批人已失效，请联系管理员。流程不会自动跳过。</view><view wx:for="{{record.nodes}}" wx:key="index" class="node"><view>{{index+1}}. {{item.name}} · {{item.mode==='all'?'会签':'或签'}}</view><view class="sub">{{item.peopleText}} · {{item.state}}</view><view wx:for="{{item.decisions}}" wx:for-item="d" wx:key="user_id" class="note">{{d.name}}：{{d.label}} {{d.note}}</view></view></block></view><view class="box"><view class="heading row" data-key="cc" bindtap="toggle">知会人员 <text>{{cc?'⌃':'⌄'}}</text></view><block wx:if="{{cc}}"><view>固定：{{record.fixedCc}}</view><view>追加：{{record.extraCc}}</view></block></view><button wx:if="{{record.can_resubmit}}" class="primary" bindtap="resubmit">修改并重新提交</button><view wx:if="{{record.status==='approved'}}" class="sub">审批通过不代表已付款。</view></block></view></scroll-view>
