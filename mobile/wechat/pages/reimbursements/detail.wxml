<navigation-bar title="报销详情" back="{{true}}" color="#182331" background="#ffffff"/><scroll-view scroll-y class="scrollarea" type="list"><view class="oa"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view wx:if="{{decisionResult}}" class="box">{{decisionResult}}</view><view wx:if="{{loading || busy}}" class="sub">正在处理…</view><block wx:if="{{record}}"><view class="box"><view class="heading">申请信息</view><view class="title">{{record.title}}</view><view class="row"><text>{{record.owner.name}} · {{record.type}}</text><text class="status {{record.status}}">{{record.state}}</text></view><view class="amount">¥{{record.total}}</view><view class="sub">{{record.date}} · BX-{{record.reimbursement_id}}</view><view class="note">{{record.note}}</view><view class="row"><text class="sub">提交版本</text><button wx:for="{{record.versions}}" wx:key="number" class="text-button" data-id="{{item.id}}" bindtap="version">V{{item.number}}</button></view></view>
<view wx:if="{{canApprove}}" class="box"><view class="heading">审批处理</view><view class="sub">当前节点：{{record.nodes[record.node_index].name}}</view><view class="field-label">审批意见（驳回必填）</view><textarea value="{{decisionNote}}" maxlength="2000" disabled="{{busy || loading}}" bindinput="note" placeholder="请填写审批意见" aria-label="审批意见，驳回必填"/><view class="row"><button disabled="{{busy || loading}}" data-decision="reject" bindtap="decide">驳回</button><button class="primary" disabled="{{busy || loading}}" data-decision="approve" bindtap="decide">通过</button></view></view>
<view class="box"><view class="heading">费用汇总</view><view wx:for="{{record.expenseSummary.groups}}" wx:key="index" class="expense summary-row"><view class="grow">{{item.description}}<text wx:if="{{item.count > 1}}" class="sub"> · {{item.count}}笔</text></view><text class="summary-money">¥{{item.total}}</text></view><view class="heading row" data-key="expenses" bindtap="toggle">发票附件 <text>{{expenses?'⌃':'⌄'}}</text></view><button class="text-button" disabled="{{busy}}" bindtap="zip">一键下载全部发票</button><block wx:if="{{expenses}}"><view wx:for="{{record.expenseSummary.files}}" wx:for-item="file" wx:key="id" class="file row"><view class="grow">{{file.name}}<view class="sub">{{file.kind}}</view></view><button class="eye" aria-label="预览发票" data-i="{{file.i}}" data-j="{{file.j}}" data-action="preview" bindtap="file"><view class="eye-icon"><view class="eye-pupil"/></view></button><button class="text-button" data-i="{{file.i}}" data-j="{{file.j}}" data-action="download" bindtap="file">下载</button></view></block></view>
<view class="box"><view class="heading row" data-key="progress" bindtap="toggle">审批进度 <text>{{progress?'⌃':'⌄'}}</text></view><block wx:if="{{progress}}"><view wx:if="{{record.blocked}}" class="error">审批人已失效，请联系管理员。流程不会自动跳过。</view><view wx:for="{{record.nodes}}" wx:key="index" class="node"><view>{{index+1}}. {{item.name}} · {{item.mode==='all'?'会签':'或签'}}</view><view class="sub">{{item.peopleText}} · {{item.state}}</view><view wx:for="{{item.decisions}}" wx:for-item="d" wx:key="user_id" class="note">{{d.name}}：{{d.label}} {{d.note}}</view></view></block></view><view class="box"><view class="heading row" data-key="cc" bindtap="toggle">知会人员 <text>{{cc?'⌃':'⌄'}}</text></view><block wx:if="{{cc}}"><view>固定：{{record.fixedCc}}</view><view>追加：{{record.extraCc}}</view></block></view><button wx:if="{{record.can_resubmit}}" class="primary" bindtap="resubmit">修改并重新提交</button><view wx:if="{{record.status==='approved'}}" class="sub">审批通过不代表已付款。</view></block></view></scroll-view>
