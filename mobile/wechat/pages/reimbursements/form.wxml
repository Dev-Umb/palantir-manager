<navigation-bar title="报销申请" back="{{true}}" color="#182331" background="#ffffff"/><scroll-view scroll-y class="scrollarea" type="list"><view wx:if="{{draftStatus}}" class="draft-save" bindtap="retryDraft">{{draftStatus}} · 仅自己可见</view><button wx:if="{{draftConflict}}" bindtap="reloadDraft">重新打开最新草稿</button><view class="oa form-space"><view wx:if="{{batchId}}" class="box"><view class="sub">AI 已整理，请核对发票、金额和报销类型，确认无误后提交。</view><view wx:if="{{batchIssues}}" class="error">{{batchIssues}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="box"><view class="heading">申请信息</view><view class="field-label">报销标题</view><input disabled="{{busy || loading}}" placeholder="例如：客户拜访差旅报销" value="{{title}}" maxlength="120" data-key="title" bindinput="input"/><view class="field-label">报销类型</view><picker range="{{typeLabels}}" value="{{typeIndex}}" bindchange="type"><view class="field">{{typeLabels[typeIndex]}} ▾</view></picker><view class="field-label">报销说明</view><textarea disabled="{{busy || loading}}" placeholder="报销说明" value="{{note}}" maxlength="2000" data-key="note" bindinput="input"/></view><view class="box" wx:for="{{items}}" wx:for-item="expense" wx:for-index="i" wx:key="key"><view class="row"><text class="heading">费用 {{i+1}}</text><button wx:if="{{items.length>1}}" class="text-button" disabled="{{busy || uploading}}" data-i="{{i}}" bindtap="remove">删除</button></view><view class="field-label">费用说明</view><textarea class="expense-description" disabled="{{busy || loading}}" placeholder="填写费用用途，发票信息识别后自动带入" maxlength="500" value="{{expense.description}}" data-i="{{i}}" data-key="description" bindinput="itemInput"/><view class="expense-fields"><view class="expense-field"><view class="field-label">金额（元）</view><input disabled="{{busy || loading}}" type="digit" placeholder="0.00" value="{{expense.amount}}" data-i="{{i}}" data-key="amount" bindinput="itemInput"/></view><view class="expense-field"><view class="field-label">开票日期</view><view class="date-control"><picker mode="date" value="{{expense.invoice_date}}" disabled="{{busy || loading}}" data-i="{{i}}" data-key="invoice_date" bindchange="itemInput"><view class="date-value {{expense.invoice_date?'':'placeholder'}}">{{expense.invoice_date || '选择日期'}}</view></picker><button wx:if="{{expense.invoice_date}}" class="clear-date" aria-label="清除开票日期" disabled="{{busy || loading}}" data-i="{{i}}" data-key="invoice_date" bindtap="clearDate">×</button></view></view></view><view wx:for="{{expense.attachments}}" wx:for-item="file" wx:for-index="j" wx:key="id" class="invoice-file"><view class="invoice-top"><view class="invoice-icon">{{file.mime==='application/pdf'?'PDF':'图片'}}</view><view class="grow"><view class="invoice-name">{{file.name}}</view><view class="invoice-status">{{file.recognizing?'正在识别…':'已上传'}}</view></view></view><view wx:if="{{file.recognitionError}}" class="invoice-error">{{file.recognitionError}}</view><view class="invoice-actions"><button wx:if="{{file.recognitionLines.length}}" class="text-button" disabled="{{busy || loading}}" data-i="{{i}}" data-j="{{j}}" bindtap="applyInvoice">核对发票</button><button wx:if="{{file.mime==='application/pdf' && !file.recognizing}}" class="text-button" disabled="{{busy || loading}}" data-i="{{i}}" data-j="{{j}}" bindtap="recognize">{{file.recognition?'重新识别':'识别发票'}}</button><button class="text-button remove-invoice" disabled="{{busy || uploading}}" data-i="{{i}}" data-j="{{j}}" bindtap="removeFile">移除</button></view></view><view wx:for="{{expense.failed}}" wx:for-item="file" wx:for-index="j" wx:key="path" class="file row"><view class="grow">{{file.name}} · 失败</view><button class="text-button" disabled="{{uploading}}" data-i="{{i}}" data-j="{{j}}" bindtap="retry">重试</button><button class="text-button" data-i="{{i}}" data-j="{{j}}" data-failed="{{true}}" bindtap="removeFile">移除</button></view><button disabled="{{busy || uploading || items.length>=50 && (expense.attachments.length || expense.failed.length)}}" class="add-invoice" data-i="{{i}}" bindtap="choose">{{uploading?'上传中…':'＋ 添加发票（图片 / PDF）'}}</button></view><button disabled="{{busy || uploading || items.length>=50}}" bindtap="add">＋ 添加费用</button><view class="box"><view class="heading">追加知会人</view><checkbox-group bindchange="cc"><label wx:for="{{users}}" wx:key="id" class="cc-person"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy || loading}}"/>{{item.name}}</label></checkbox-group></view></view></scroll-view><view class="oa-bottom row"><view><view class="total-label">合计金额</view><view class="total-amount">¥{{total}}</view></view><button class="primary" loading="{{busy}}" disabled="{{busy || uploading || loading}}" bindtap="submit">提交申请</button></view>

<view wx:if="{{invoiceReview}}" class="invoice-review-mask" catchtouchmove="stopReviewTouch">
 <view class="invoice-review-sheet" role="dialog" aria-label="核对发票信息">
  <view class="review-header"><view class="review-title">核对发票信息</view><view class="review-file-name">{{invoiceReview.name}}</view></view>
  <scroll-view scroll-y type="list" class="review-scroll">
   <view class="review-body"><view class="review-columns"><view class="review-column"><view class="review-label">金额（元）</view><view class="review-amount">{{invoiceReview.amount || '未识别'}}</view><view wx:if="{{invoiceReview.previousAmount}}" class="review-note">原金额 {{invoiceReview.previousAmount}}</view></view><view class="review-column"><view class="review-label">开票日期</view><view class="review-date">{{invoiceReview.date || '未识别'}}</view><view wx:if="{{invoiceReview.previousDate}}" class="review-note">原日期 {{invoiceReview.previousDate}}</view></view></view>
   <view class="review-label">费用说明</view><view class="review-description"><view wx:for="{{invoiceReview.descriptionLines}}" wx:key="index">{{item}}</view><view wx:if="{{!invoiceReview.description}}">未识别，可在费用中手动填写</view></view>
   <view class="review-note">请对照原件核对，填入后仍可修改。仅填入本张发票，不累加其他费用。</view><view wx:for="{{invoiceReview.warnings}}" wx:key="*this" class="review-note">{{item}}</view></view>
  </scroll-view>
  <view class="review-actions"><button bindtap="cancelInvoiceReview">暂不填入</button><button class="review-confirm" bindtap="confirmInvoiceReview">确认填入</button></view>
 </view>
</view>
