<navigation-bar title="报销申请" back="{{true}}" color="#182331" background="#ffffff"/><scroll-view scroll-y class="scrollarea" type="list"><view class="oa form-space"><view wx:if="{{error}}" class="error">{{error}}</view><view class="box"><view class="heading">申请信息</view><view class="field-label">报销标题</view><input disabled="{{busy}}" placeholder="例如：客户拜访差旅报销" value="{{title}}" maxlength="120" data-key="title" bindinput="input"/><view class="field-label">报销类型</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="type"><view class="field">{{types[typeIndex]}} ▾</view></picker><view class="field-label">报销说明</view><textarea disabled="{{busy}}" placeholder="报销说明" value="{{note}}" maxlength="2000" data-key="note" bindinput="input"/></view><view class="box" wx:for="{{items}}" wx:for-item="expense" wx:for-index="i" wx:key="key"><view class="row"><text class="heading">费用 {{i+1}}</text><button wx:if="{{items.length>1}}" class="text-button" disabled="{{busy || uploading}}" data-i="{{i}}" bindtap="remove">删除</button></view><view class="field-label">费用说明</view><input disabled="{{busy}}" placeholder="费用说明" maxlength="500" value="{{expense.description}}" data-i="{{i}}" data-key="description" bindinput="itemInput"/><view class="field-label">金额（元）</view><input disabled="{{busy}}" type="digit" placeholder="金额（元）" value="{{expense.amount}}" data-i="{{i}}" data-key="amount" bindinput="itemInput"/><view wx:for="{{expense.attachments}}" wx:for-item="file" wx:for-index="j" wx:key="id" class="file row"><view class="grow">{{file.name}}<text class="sub"> · 已上传</text></view><button class="text-button" disabled="{{busy || uploading}}" data-i="{{i}}" data-j="{{j}}" bindtap="removeFile">移除</button></view><view wx:for="{{expense.failed}}" wx:for-item="file" wx:for-index="j" wx:key="path" class="file row"><view class="grow">{{file.name}} · 失败</view><button class="text-button" disabled="{{uploading}}" data-i="{{i}}" data-j="{{j}}" bindtap="retry">重试</button><button class="text-button" data-i="{{i}}" data-j="{{j}}" data-failed="{{true}}" bindtap="removeFile">移除</button></view><button disabled="{{busy || uploading || expense.attachments.length>=10}}" class="text-button" data-i="{{i}}" bindtap="choose">{{uploading?'上传中…':'＋ 添加发票（图片 / PDF）'}}</button></view><button disabled="{{busy || uploading || items.length>=50}}" bindtap="add">＋ 添加费用</button><view class="box"><view class="heading">追加知会人</view><checkbox-group bindchange="cc"><label wx:for="{{users}}" wx:key="id" class="cc-person"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy}}"/>{{item.name}}</label></checkbox-group></view></view></scroll-view><view class="oa-bottom row"><view><view class="total-label">合计金额</view><view class="total-amount">¥{{total}}</view></view><button class="primary" loading="{{busy}}" disabled="{{busy || uploading || loading}}" bindtap="submit">提交申请</button></view>
