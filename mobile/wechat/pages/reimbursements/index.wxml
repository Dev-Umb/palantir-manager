<navigation-bar title="{{approval?'OA 审批':'报销 OA'}}" back="{{true}}" color="#182331" background="#ffffff"/><scroll-view scroll-y class="scrollarea" type="list"><view class="oa"><view wx:if="{{approval}}" class="heading">待我审批 · {{total}} 笔</view><view wx:if="{{!approval}}" class="row"><button class="text-button scope-tab {{scope==='mine'?'selected':''}}" data-scope="mine" bindtap="scope">我的报销</button><button class="text-button scope-tab {{scope==='cc'?'selected':''}}" data-scope="cc" bindtap="scope">知会我的</button><button class="text-button scope-tab {{scope==='drafts'?'selected':''}}" data-scope="drafts" bindtap="scope">我的草稿</button></view><view class="create-row"><button wx:if="{{canSubmit}}" class="primary" bindtap="create">＋ 发起报销</button><button wx:if="{{canSubmit && batchEnabled}}" class="primary" bindtap="batch">批量报销</button></view><view wx:if="{{scope==='drafts' && batches.length}}" class="box"><view class="batch-row" wx:for="{{batches}}" wx:key="id"><view>{{item.label}} · {{item.processed}} / {{item.total}} 份</view><view class="sub">{{item.draft_count}} 份草稿</view><view wx:if="{{item.failed_names.length}}" class="sub">以下文件未识别成功，可重新上传：{{item.failed_names}}</view></view><button class="text-button" bindtap="refresh">刷新</button></view><view wx:if="{{!approval && scope!=='drafts'}}" class="row box"><picker range="{{statusLabels}}" value="{{statusIndex}}" data-key="status" bindchange="filter">{{statusLabels[statusIndex]}} ▾</picker><picker range="{{typeLabels}}" value="{{typeIndex}}" data-key="type" bindchange="filter">{{typeLabels[typeIndex]}} ▾</picker></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view wx:if="{{loading}}" class="sub">加载中…</view><view class="box record {{approval?'approval-record':''}}" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
 <block wx:if="{{approval}}">
  <view class="approval-top"><view class="approval-person"><view class="approval-label">申请人</view><view class="approval-name">{{item.owner.name || '未提供申请人'}}</view></view><view class="approval-money"><view class="approval-label">报销金额（元）</view><view class="approval-value">¥{{item.total}}</view></view></view>
  <view class="approval-subject">{{item.title}}</view>
  <view class="approval-meta"><text class="approval-type">{{item.type}}</text><text class="status {{item.status}}">{{item.state}}</text></view>
  <view wx:if="{{item.note}}" class="approval-reason">{{item.note}}</view>
  <view class="approval-meta approval-reference"><text>提交于 {{item.date}}</text><text>BX-{{item.reimbursement_id}} · V{{item.number}}</text></view>
  <view class="approval-footer"><text class="approval-node">当前节点：{{item.nodes[item.node_index].name}}</text><text class="approval-open">查看并审批 ›</text></view>
 </block>
 <block wx:else><view class="row"><text class="sub">{{scope==='drafts'?'未提交 · 仅自己可见':'BX-'+item.reimbursement_id+' · V'+item.number}}</text><text class="status {{item.status}}">{{item.state}}</text></view><view wx:if="{{item.batchId}}" class="draft-source"><view wx:if="{{item.unread}}" class="draft-unread-dot" aria-label="新草稿"/><text>AI批量识别创建</text></view><view class="heading record-title">{{item.title}}</view><view class="sub">{{item.type}} · {{item.date}}</view><view class="row record-footer"><text class="record-amount">¥{{item.total}}</text><view class="record-actions"><text class="sub">{{scope==='drafts'?'继续编辑 ›':'查看详情 ›'}}</text><button wx:if="{{scope==='drafts'}}" class="draft-delete delete-icon-button" data-id="{{item.id}}" catchtap="deleteDraft" disabled="{{!!deleting}}" loading="{{deleting===item.id}}" aria-label="删除草稿：{{item.title}}"><view class="trash-icon"><view class="trash-lid"/><view class="trash-bin"/></view></button></view></view></block>
</view><view wx:if="{{!rows.length && !loading && !error}}" class="sub">{{approval?'暂无待你审批的报销':'暂无记录'}}</view><view class="row oa-pagination"><button disabled="{{page<=1}}" bindtap="previous">上一页</button><text>{{page}} / {{last}}</text><button disabled="{{page>=last}}" bindtap="next">下一页</button></view></view></scroll-view>
