<view class="procurement" wx:if="{{!notice}}">
 <view class="procurement-search"><input placeholder="搜索项目、采购单位、编号" value="{{procurementQuery}}" bindinput="procurementInput" bindconfirm="searchProcurement"/><button bindtap="searchProcurement" disabled="{{busy}}">搜索</button><button class="procurement-filter-button" bindtap="showProcurementFilters" disabled="{{busy}}">筛选</button></view>
 <view class="procurement-stats" wx:if="{{procurementLoaded}}"><view><text>{{procurementTotal}}</text>匹配公告</view><view><text>{{procurementTotals.P1 || 0}}</text>优先对接 P1</view><view><text>{{procurementTotals.P2 || 0}}</text>条件匹配 P2</view><view><text>{{procurementTotals['待核实'] || 0}}</text>待核实</view></view>
 <view class="procurement-tabs"><button class="{{!procurementFilters.priority?'selected':''}}" data-value="" bindtap="quickProcurement">全部</button><button class="{{procurementFilters.priority==='P1'?'selected':''}}" data-value="P1" bindtap="quickProcurement">优先对接 P1</button><button class="{{procurementFilters.priority==='待核实'?'selected':''}}" data-value="待核实" bindtap="quickProcurement">待核实</button></view>
 <view wx:for="{{notices}}" wx:key="id" class="procurement-card" data-id="{{item.id}}" bindtap="openNotice" role="button" aria-label="查看完整详情">
 <view class="procurement-meta"><text class="procurement-priority">{{item.priority}}</text><text>{{item.method || item.p.nature}}</text><text wx:if="{{item.invited}}">定向采购</text></view>
 <view class="procurement-title clamp">{{item.title}}</view><view class="procurement-muted clamp">{{item.p.unit}}</view><view class="procurement-muted">{{item.p.category}} · {{item.p.platform}}</view>
 <view class="procurement-facts"><view><text>采购规模</text><view>{{item.p.quantity || '未提供'}}</view></view><view><text>报价 / 投标截止</text><view>{{item.p.deadline || '未提供'}}</view></view></view>
 <view class="procurement-warning" wx:if="{{item.hasIssues}}">核实提示 · {{item.issueText}}</view><view class="procurement-link">查看完整详情 →</view></view>
 <view wx:if="{{procurementLoaded && !busy && !error && !notices.length}}" class="empty">暂无匹配公告，请调整筛选条件。</view>
 <view class="row" wx:if="{{procurementLoaded}}"><button bindtap="previousProcurement" disabled="{{busy || procurementPage<=1}}">上一页</button><text>{{procurementPage}} / {{procurementLast}}</text><button bindtap="nextProcurement" disabled="{{busy || procurementPage>=procurementLast}}">下一页</button></view>
 <view class="procurement-muted">优先级为采集端初判，具体条件请以原公告为准。</view>
</view>
<view wx:if="{{notice}}" class="procurement procurement-detail"><button class="procurement-back" bindtap="closeNotice">‹ 返回公告列表</button><view class="procurement-card"><view class="procurement-meta"><text class="procurement-priority">{{notice.priority}}</text><text>{{notice.method || notice.p.nature}}</text><text wx:if="{{notice.invited}}">定向采购</text></view><view class="procurement-title">{{notice.title}}</view><view>{{notice.p.unit}}</view><view class="procurement-warning" wx:if="{{notice.hasIssues}}">{{notice.issueText}}</view></view>
<view wx:for="{{procurementWarnings}}" wx:key="*this" class="procurement-warning">{{item}}</view>
<view class="procurement-card"><view wx:for="{{notice.fields}}" wx:key="key" class="procurement-field"><view class="procurement-muted">{{item.label}}</view><text selectable>{{item.value}}</text></view></view><view class="procurement-muted">采集端判断尚未经平台原文核验；未知时间不作推断。</view></view>
