<block wx:if="{{!notice}}"><view class="row"><input placeholder="搜索招采公告" value="{{procurementQuery}}" bindinput="procurementInput"/><button bindtap="searchProcurement" disabled="{{busy}}">搜索</button></view><view class="hint">{{procurementTotal}} 条</view><view wx:for="{{notices}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openNotice"><view class="name">{{item.title}}</view><view>{{item.region}} · {{item.published_at}}</view><view>{{item.recommendation_summary}}</view></view><view wx:if="{{!busy && !error && !notices.length}}" class="empty">暂无匹配公告</view><view class="row"><button bindtap="previousProcurement" disabled="{{busy || procurementPage<=1}}">上一页</button><text>{{procurementPage}} / {{procurementLast}}</text><button bindtap="nextProcurement" disabled="{{busy || procurementPage>=procurementLast}}">下一页</button></view></block>
<view wx:else><button bindtap="closeNotice">返回公告列表</button><view class="title">{{notice.title}}</view><text selectable>{{notice.summary}}</text><view wx:for="{{notice.evidence}}" wx:key="id" class="card"><text selectable>{{item.text}}</text><button wx:if="{{item.url}}" data-url="{{item.url}}" bindtap="copySource">复制原文链接</button></view><view wx:for="{{noticeReport}}" wx:key="id" class="card"><text selectable>{{item.text}}</text></view></view>
