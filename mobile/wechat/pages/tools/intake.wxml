<button bindtap="chooseFile" disabled="{{busy}}">从微信会话选择合同文件</button><view wx:if="{{uploadFile}}" class="card"><text>{{uploadFile.name}}</text><button bindtap="uploadContract" disabled="{{busy || intakeActive}}">上传并识别</button></view>
<view wx:for="{{intakes}}" wx:key="id" class="cell" data-id="{{item.id}}" bindtap="openIntake"><view>{{item.file_name}}</view><text class="muted">{{item.statusLabel}} ›</text></view>
<view wx:if="{{intake}}" class="card"><view class="subtitle">{{intake.file_name}}</view><view>{{intakeStatus}}</view><view wx:if="{{intake.error}}" class="error">{{intake.error}}</view><button wx:if="{{intake.status==='failed'}}" bindtap="retryIntake" disabled="{{busy}}">重新识别</button><view wx:if="{{intake.status==='confirmed'}}">已完成归档</view></view>
<block wx:if="{{intake.status==='review'}}">
 <view class="card"><view class="subtitle">1. 选择归属项目</view><input placeholder="项目名称或编号" value="{{projectSearch}}" bindinput="projectSearchInput"/><button bindtap="searchIntakeProjects" disabled="{{busy}}">搜索</button><view wx:if="{{projectsTruncated}}" class="hint">结果超过 50 个，请缩小搜索范围</view><button wx:for="{{intakeProjects}}" wx:key="id" data-id="{{item.id}}" bindtap="selectIntakeProject" disabled="{{busy}}">{{item.code}} {{item.name}}</button><view wx:if="{{intakeProject}}">已选：{{intakeProject.name}}</view></view>
 <view wx:if="{{intakeProject}}" class="card"><view class="subtitle">2. 选择合同</view><button data-id="__new__" bindtap="selectIntakeContract">{{contractChoice==='__new__'?'✓ ':''}}新建合同</button><button wx:for="{{intakeProject.contracts}}" wx:key="id" data-id="{{item.id}}" bindtap="selectIntakeContract">{{contractChoice===item.id?'✓ ':''}}{{item.code}} {{item.fields.ctype}} {{item.fields.amount}}</button></view>
 <view class="card"><view class="subtitle">3. 人工核对识别结果</view><view class="field"><label>合同金额（元）*</label><input value="{{intakeFields.amount}}" data-key="amount" bindinput="intakeInput"/></view><view class="field"><label>合同类型：销售合同/加工合同/补充协议</label><input value="{{intakeFields.ctype}}" data-key="ctype" bindinput="intakeInput"/></view><view class="field"><label>签订日期（YYYY-MM-DD）</label><input value="{{intakeFields.signed_date}}" data-key="signed_date" bindinput="intakeInput"/></view><view class="field"><label>合同数量</label><input value="{{intakeFields.contract_qty}}" data-key="contract_qty" bindinput="intakeInput"/></view><view class="field"><label>项目合同重量（吨，可选）</label><input value="{{projectWeight}}" bindinput="weightInput"/></view><view wx:if="{{intakeProject.can_update_project_amount}}"><switch checked="{{updateAmount}}" bindchange="amountSwitch"/>同步项目主档合同金额</view><button bindtap="previewIntake" disabled="{{busy}}">查看归档差异</button></view>
 <view wx:if="{{intakePreview}}" class="card"><view class="subtitle">{{intakePreview.project.name}} · {{intakePreview.contract}}</view><view wx:for="{{intakePreview.changes}}" wx:key="label" class="cell">{{item.label}}：{{item.before}} → {{item.after}}</view><view wx:for="{{intakePreview.effects}}" wx:key="*this" class="hint">{{item}}</view><button class="primary" bindtap="confirmIntake" disabled="{{busy}}">确认归档</button></view>
</block>
