page{height:100vh;display:flex;flex-direction:column;background:#f6f7f9}.scrollarea{flex:1;min-height:0}.customer-intro{font-size:26rpx;color:#596575;line-height:1.6;margin:24rpx 28rpx}.customer-card{margin:0 28rpx 24rpx;padding:8rpx 28rpx;background:#fff;border-radius:20rpx}.field{padding:24rpx 0;border-bottom:1rpx solid #edf0f3}.field:last-child{border-bottom:0}.field label{display:flex;align-items:center;font-size:28rpx;color:#344354;margin-bottom:12rpx}.optional{font-size:24rpx;color:#667384;margin-left:16rpx}.required{color:#b8463b;margin-left:8rpx}.field input,.field textarea,.field picker{box-sizing:border-box;width:100%;min-height:80rpx;padding:18rpx 20rpx;font-size:30rpx;background:#f8f9fb;border:1rpx solid #e3e7ec;border-radius:12rpx}.field-hint{font-size:24rpx;line-height:1.5;color:#667384;margin-top:10rpx}button.more-toggle{display:flex;align-items:center;justify-content:space-between;width:calc(100% - 56rpx);min-height:96rpx;padding:20rpx 8rpx;margin:12rpx 28rpx;background:transparent;color:#344354;font-size:28rpx;text-align:left}.more-toggle text{color:#2864bd}.more-toggle::after{border:0}.customer-footer{flex-shrink:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e8ecf0}button.save{margin:0;width:100%;min-height:92rpx;padding:22rpx;background:#2864bd;color:#fff;border-radius:14rpx;font-size:30rpx;line-height:1.5}
