<navigation-bar title="客户详情" back="{{true}}" color="#192b42" background="#ffffff" /><scroll-view class="scrollarea" scroll-y type="list"><view class="content"><view wx:if="{{error}}" class="error">{{error}}<button class="small" bindtap="refresh">重试</button></view><view wx:if="{{loading}}" class="loading">正在加载…</view><block wx:if="{{customer}}"><view class="title">{{customer.title}}</view><view class="muted">{{customer.display.address || '地址未维护'}}</view><view class="section subtitle">联系人</view><view wx:for="{{customer.contacts}}" wx:key="id" class="cell"><view class="name">{{item.name}}</view><text selectable>{{item.phone || '电话未维护'}}</text></view><view wx:if="{{!customer.contacts.length}}" class="empty">暂无可见联系人</view><view class="section subtitle">合作项目</view><view wx:for="{{customer.cooperation_projects}}" wx:key="id" class="cell" data-id="{{item.id}}" bindtap="openProject"><view class="name">{{item.name || item.title}}</view><view class="muted">{{item.code}}</view></view><view wx:if="{{!customer.cooperation_projects.length}}" class="empty">暂无可见合作项目</view></block></view></scroll-view>