page{height:100vh;display:flex;flex-direction:column;background:#f6f7f9;}
.editor-content{padding:28rpx 28rpx 40rpx;box-sizing:border-box;}.form-card{padding:32rpx;background:#fff;border-radius:20rpx;}.form-heading{font-size:34rpx;font-weight:600;}.form-description{font-size:24rpx;color:#7f8998;margin-top:12rpx;margin-bottom:8rpx;}.editor-field{margin-top:32rpx;}.field-label{font-size:28rpx;color:#344354;line-height:1.5;margin-bottom:14rpx;}.required{color:#b8463b;}
.field-input,.field-textarea,.field-select,.relation-control{width:100%;box-sizing:border-box;background:#f8f9fb;border:1rpx solid #e3e7ec;border-radius:12rpx;font-size:28rpx;color:#182331;}.field-input{height:92rpx;padding:20rpx 24rpx;}.field-textarea{height:200rpx;padding:20rpx 24rpx;}.field-select,button.relation-control{display:flex;flex-direction:row;align-items:center;justify-content:space-between;min-height:92rpx;padding:20rpx 24rpx;text-align:left;line-height:1.5;margin:0;}.relation-label{flex:1;min-width:0;white-space:normal;word-break:break-all;}.chevron{color:#8a95a5;flex-shrink:0;margin-left:16rpx;}
.editor-footer,.choice-footer{flex-shrink:0;background:#fff;padding:20rpx 28rpx 36rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-top:1rpx solid #e8ecf0;}button.save-button{width:100%;height:92rpx;padding:24rpx;background:#2864bd;color:#fff;border-radius:14rpx;box-sizing:border-box;margin:0;}
.choice-header{padding:24rpx 28rpx 16rpx;background:#fff;flex-shrink:0;}.choice-search{display:flex;flex-direction:row;align-items:center;background:#f0f2f5;border-radius:14rpx;padding-left:20rpx;}.choice-search input{flex:1;min-width:0;width:0;height:88rpx;background:transparent;border:0;padding:20rpx 8rpx;}.choice-search button{width:120rpx;flex-shrink:0;font-size:26rpx;padding:24rpx 12rpx;background:transparent;margin:0;color:#2864bd;}.choice-hint{font-size:24rpx;line-height:1.6;color:#7f8998;margin-top:16rpx;}.choice-list{flex:1;min-height:0;width:100%;}.choice-content{padding:20rpx 28rpx;}.choice-option{display:flex;flex-direction:row;align-items:center;background:#fff;min-height:100rpx;box-sizing:border-box;padding:28rpx 24rpx;border-bottom:1rpx solid #edf0f3;}.choice-label{flex:1;min-width:0;font-size:28rpx;line-height:1.5;word-break:break-all;}.choice-check{width:48rpx;margin-left:16rpx;flex-shrink:0;color:#2864bd;text-align:right;}.choice-option.is-selected{background:#eaf1fc;}.choice-footer{display:flex;flex-direction:row;}.choice-footer button{box-sizing:border-box;height:92rpx;border-radius:14rpx;margin:0;padding:24rpx;}.choice-footer .clear-button{width:220rpx;flex-shrink:0;margin-right:20rpx;background:#f0f2f5;color:#536173;}.choice-footer .done-button{flex:1;min-width:0;background:#2864bd;color:white;}

.editor-field button.relation-control{width:100% !important;max-width:none;}.field-label{display:flex;flex-direction:row;align-items:center;}.field-label .required{margin-left:6rpx;}
