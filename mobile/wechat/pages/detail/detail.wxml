<navigation-bar title="项目详情" back="{{true}}" color="#192b42" background="#ffffff" /><scroll-view class="scrollarea" scroll-y type="list"><view class="content"><view wx:if="{{error}}" class="error">{{error}}<button class="small" bindtap="refresh">重试</button></view><view wx:if="{{loading}}" class="loading">正在加载…</view><block wx:if="{{p}}"><view class="tag">{{p.status}}</view><view class="title">{{p.name}}</view><view class="muted">{{p.code}} · {{p.customer}}</view><view class="filters"><button wx:for="{{tabs}}" wx:key="*this" data-tab="{{item}}" bindtap="tab" class="{{tab===item?'selected':''}}">{{item}}</button></view><view wx:if="{{tab==='概况'}}"><view wx:for="{{fields}}" wx:key="key" class="kv"><text class="muted">{{item.label}}</text><text selectable>{{item.value}}</text></view></view><block wx:elif="{{tab==='合同'}}"><view wx:for="{{contracts}}" wx:key="id" class="card"><view class="name">{{item.title || item.code}}</view><view class="kv"><text>类型</text><text>{{item.payload.ctype || '—'}}</text></view><view class="kv"><text>本份金额</text><text>¥{{item.amountText}}</text></view><view class="kv"><text>签订日期</text><text>{{item.payload.signed_date || '—'}}</text></view><view class="kv"><text>数量</text><text>{{item.display.contract_qty || '—'}}</text></view><view class="muted">{{item.payload.remark || ''}}</view><button wx:for="{{item.files}}" wx:for-item="file" wx:for-index="fileIndex" wx:key="content_url" class="small" data-contract="{{item.id}}" data-index="{{fileIndex}}" bindtap="attachment">{{file.name}}</button></view><view wx:if="{{!contracts.length}}" class="empty">暂无可见合同</view><button bindtap="unavailable">上传并识别合同</button></block><view wx:else><view class="kv"><text>合同金额</text><text>¥{{p.amountText}}</text></view><view class="kv"><text>已发生金额</text><text>¥{{p.incurredText}}</text></view><view class="kv"><text>已回款金额</text><text>¥{{p.paidText}}</text></view><view class="kv"><text>未回款金额</text><text>¥{{p.unpaidText}}</text></view><view class="kv"><text>回款进度</text><text>{{p.progress}}</text></view><view class="kv"><text>末次回款</text><text>{{p.lastPayment}}</text></view></view><button wx:if="{{canEdit}}" class="primary" bindtap="edit">编辑项目资料</button></block></view></scroll-view>