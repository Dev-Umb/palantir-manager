.procurement-entry{padding:28rpx;margin-bottom:24rpx}.procurement-entry .name{color:#2464aa;display:flex;align-items:center;justify-content:space-between}.procurement-entry text{display:block;margin-left:20rpx}

.preview-screen .business-actions{display:flex;gap:20rpx;margin-bottom:20rpx}.preview-screen .business-actions button{flex:1;width:0;min-width:0;margin:0;padding:26rpx 4rpx;font-size:28rpx;min-height:88rpx}

.preview-screen .oa-entry{display:flex;align-items:center;justify-content:space-between;width:100%;box-sizing:border-box;margin:0 0 20rpx;padding:26rpx 28rpx;border:1rpx solid #d7e4fa;border-radius:20rpx;background:#edf3fe;color:#245ba4;font-size:30rpx;font-weight:600;line-height:1.5;text-align:left}.oa-entry .oa-entry-action{font-size:25rpx;font-weight:400}
